<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LaserGRBL.Dialogs.SafetyCountdownDialog"
        Title="Safety Check"
        Width="340" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Center" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="BtnGo"     Content="GO"     Click="BtnGo_Click"     Width="80" FontWeight="Bold"/>
      <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" IsCancel="True" Width="80"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="⚠ Laser is about to fire!"
                 FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="TxtCountdown" Text="Starting in 3..."
                 FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0"/>
      <TextBlock Text="Ensure the work area is clear." FontSize="11"
                 Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
    </StackPanel>
  </DockPanel>
</Window>

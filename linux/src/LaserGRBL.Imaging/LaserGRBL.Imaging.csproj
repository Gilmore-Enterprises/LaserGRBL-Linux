<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Image pipeline re-backed on SkiaSharp: RasterConverter (ImageProcessor,
    ImageTransform, Dithering), CsPotrace, Clipper, Hershey, SVG rendering.
    Replaces all System.Drawing / GDI+ usage.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>LaserGRBL.Imaging</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaserGRBL.Core\LaserGRBL.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <!-- Native libSkiaSharp for Linux runtime. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="$(SkiaSharpVersion)" />
  </ItemGroup>

</Project>
